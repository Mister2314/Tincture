{
  "$schema": "https://tincture.app/theme.schema.json",
  "id": "daylight",
  "name": "Daylight",
  "author": "tincture",
  "date": "2026-10-12",
  "version": "1.0.0",
  "license": "MIT",
  "appearance": "light",
  "description": "Warm paper white with an ink-blue accent. Quiet in a bright room.",
  "tokens": {
    "color": {
      "bg": "#faf8f5",
      "bgElevated": "#ffffff",
      "surface": "#ffffff",
      "surfaceHover": "#f4f1ec",
      "surfaceActive": "#eae5dd",
      "text": "#1c1a17",
      "textMuted": "#5f5a52",
      "textSubtle": "#756e66",
      "accent": "#2f5d8a",
      "accentHover": "#264d73",
      "accentText": "#ffffff",
      "border": "#c9c0af",
      "borderStrong": "#978a73",
      "focusRing": "#2f5d8a",
      "success": "#2f7d5d",
      "danger": "#b8443f"
    },
    "dimension": {
      "radiusSm": "12px",
      "radiusMd": "18px",
      "radiusLg": "26px",
      "radiusFull": "9999px",
      "spaceXs": "6px",
      "spaceSm": "10px",
      "spaceMd": "18px",
      "spaceLg": "28px",
      "spaceXl": "48px"
    },
    "fontFamily": {
      "display": "instrument-serif",
      "body": "manrope",
      "mono": "jetbrains-mono"
    },
    "shadow": {
      "card": { "x": 0, "y": 2, "blur": 6, "spread": -1, "color": "#1c1a1712" },
      "elevated": [
        { "x": 0, "y": 14, "blur": 34, "spread": -8, "color": "#1c1a171a" },
        { "x": 0, "y": 3, "blur": 10, "spread": -2, "color": "#1c1a170d" }
      ]
    }
  },
  "effects": {
    "grain": 0.05,
    "glow": 0.07,
    "motion": 1,
    "blur": 16
  }
}
