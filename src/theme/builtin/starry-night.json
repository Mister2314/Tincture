{
  "$schema": "https://tincture.app/theme.schema.json",
  "id": "starry-night",
  "name": "Starry Night",
  "author": "tincture",
  "date": "2026-10-12",
  "version": "1.0.0",
  "license": "MIT",
  "appearance": "dark",
  "description": "After Van Gogh: cypress blue, cobalt sky, and the moon's ochre.",
  "tokens": {
    "color": {
      "bg": "#0a1626",
      "bgElevated": "#102036",
      "surface": "#152a45",
      "surfaceHover": "#1c3556",
      "surfaceActive": "#244068",
      "text": "#e8e4d6",
      "textMuted": "#9fb0c4",
      "textSubtle": "#6b7f96",
      "accent": "#e9c04a",
      "accentHover": "#f4d067",
      "accentText": "#0a1626",
      "border": "#1f3856",
      "borderStrong": "#315075",
      "focusRing": "#e9c04a",
      "success": "#5fb89a",
      "danger": "#d9705e"
    },
    "dimension": {
      "radiusSm": "4px",
      "radiusMd": "10px",
      "radiusLg": "18px",
      "radiusFull": "9999px",
      "spaceXs": "4px",
      "spaceSm": "8px",
      "spaceMd": "16px",
      "spaceLg": "24px",
      "spaceXl": "40px"
    },
    "fontFamily": {
      "display": "instrument-serif",
      "body": "manrope",
      "mono": "jetbrains-mono"
    },
    "shadow": {
      "card": { "x": 0, "y": 1, "blur": 3, "spread": 0, "color": "#02050999" },
      "elevated": [
        { "x": 0, "y": 10, "blur": 28, "spread": -6, "color": "#020509cc" },
        { "x": 0, "y": 2, "blur": 8, "spread": 0, "color": "#02050980" }
      ]
    }
  },
  "effects": {
    "grain": 0.06,
    "glow": 0.55,
    "motion": 0.85,
    "blur": 14
  }
}
